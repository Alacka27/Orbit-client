{
  "schemaVersion": 1,
  "id": "orbit",
  "version": "${version}",
  "name": "Orbit — FreeLook preview",
  "description": "Hold-to-look third-person camera with smooth return and saved settings. Other planned modules are not implemented yet.",
  "authors": [
    "Alacka27"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.alacka.orbit.OrbitClient"
    ]
  },
  "mixins": [
    {
      "config": "orbit.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
