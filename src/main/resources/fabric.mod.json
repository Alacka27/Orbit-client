{
  "schemaVersion": 1,
  "id": "orbit",
  "version": "${version}",
  "name": "Orbit",
  "description": "Cloud glass menus with the supplied Orbit logo and hold-to-look camera. Other planned modules are not implemented.",
  "icon": "assets/orbit/icon.png",
  "authors": [
    "Alacka27"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.alacka.orbit.OrbitClient"
    ]
  },
  "mixins": [
    {
      "config": "orbit.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
